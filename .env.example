# RateMySetup Environment Variables

# ==========================================
# Azure Blob Storage Configuration
# ==========================================
# The name of your Azure Storage account
AZURE_ACCOUNT_NAME=your_azure_storage_account_name

# The access key for your Azure Storage account
AZURE_ACCOUNT_KEY=your_azure_storage_account_key

# The blob container name where uploaded media files will be stored (e.g. media)
AZURE_CONTAINER=media

# ==========================================
# Azure Computer Vision (Image Analysis)
# ==========================================
# The endpoint for your Azure Computer Vision / Azure AI Services resource
# Example: https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_VISION_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/

# The API key for your Azure Computer Vision / Azure AI Services resource
AZURE_VISION_KEY=your_azure_computer_vision_key

# ==========================================
# Optional / Local Development & Docker DB
# ==========================================
# Django Secret Key (override for production)
SECRET_KEY=django-insecure-9ppao_0_9z-7k^gki7yu-qmwg3l1yi%6!3!j!c)0paa4a_t#-+
DEBUG=True

# Host & Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,74.241.133.70
CSRF_TRUSTED_ORIGINS=http://74.241.133.70,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Settings (Docker defaults)
POSTGRES_DB=ratemysetup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_PORT=5432
